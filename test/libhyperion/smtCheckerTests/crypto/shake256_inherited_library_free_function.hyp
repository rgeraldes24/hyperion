import "b.hyp";
contract C is Base {
	function check(bytes memory data) public pure {
		assert(hash(data) == shake256(data));
	}
}
==== Source: b.hyp ====
library L {
	function hash(bytes memory data) internal pure returns (bytes64) {
		return shake256(data);
	}
}
function freeHash(bytes memory data) pure returns (bytes64) {
	return L.hash(data);
}
contract Base {
	function hash(bytes memory data) internal pure returns (bytes64) {
		return freeHash(data);
	}
}
