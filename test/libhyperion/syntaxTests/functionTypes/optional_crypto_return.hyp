contract C {
	function xmssverify_value() internal pure returns (function (bytes memory, bytes memory, bytes memory) pure returns (bool)) {
		return xmssverify;
	}

	function shake256_value() internal pure returns (function (bytes memory) pure returns (bytes64)) {
		return shake256;
	}

	function mldsa87verify_value() internal pure returns (function (bytes64, bytes memory, bytes memory, bytes memory) pure returns (bool)) {
		return mldsa87verify;
	}
}
