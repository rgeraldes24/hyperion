contract C {
	function xmssverify_value() public pure {
		function (bytes memory, bytes memory, bytes memory) pure returns (bool) pointer = xmssverify;
	}

	function shake256_value() public pure {
		function (bytes memory) pure returns (bytes64) pointer = shake256;
	}

	function mldsa87verify_value() public pure {
		function (bytes64, bytes memory, bytes memory, bytes memory) pure returns (bool) pointer = mldsa87verify;
	}
}
