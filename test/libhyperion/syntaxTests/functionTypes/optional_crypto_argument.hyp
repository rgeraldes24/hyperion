contract C {
	function consume_xmssverify(function (bytes memory, bytes memory, bytes memory) pure returns (bool)) internal pure {}

	function xmssverify_value() public pure {
		consume_xmssverify(xmssverify);
	}

	function consume_shake256(function (bytes memory) pure returns (bytes64)) internal pure {}

	function shake256_value() public pure {
		consume_shake256(shake256);
	}

	function consume_mldsa87verify(function (bytes64, bytes memory, bytes memory, bytes memory) pure returns (bool)) internal pure {}

	function mldsa87verify_value() public pure {
		consume_mldsa87verify(mldsa87verify);
	}
}
