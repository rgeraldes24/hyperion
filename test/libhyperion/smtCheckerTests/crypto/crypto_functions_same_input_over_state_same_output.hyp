contract C {
	bytes data;
	bytes pubkey;
	bytes withdrawal_recipient;
	bytes amount;
	bytes randao_commitment;
	bytes signature;

	bytes32 kec;
	bytes32 sha;
	bytes32 dep;

	constructor(bytes memory _data, bytes memory _pubkey, bytes memory _withdrawal_recipient, bytes memory _amount, bytes memory _randao_commitment, bytes memory _signature) {
		data = _data;
		pubkey = _pubkey;
		withdrawal_recipient = _withdrawal_recipient;
		amount = _amount;
		randao_commitment = _randao_commitment;
		signature = _signature;

		kec = keccak256(data);
		sha = sha256(data);
		dep = depositroot(pubkey, withdrawal_recipient, amount, randao_commitment, signature);
	}

	function f() public view {
		bytes32 _kec = keccak256(data);
		bytes32 _sha = sha256(data);
		bytes32 _dep = depositroot(pubkey, withdrawal_recipient, amount, randao_commitment, signature);
		assert(_kec == kec);
		assert(_sha == sha);
		assert(_dep == dep);
	}
}
