==== Source: a.hyp ====
import "b.hyp";
contract A {
	B b;
	constructor() {
		b = new B();
	}
	function check(bytes memory data) public view {
		bytes64 shake = shake256(data);
		bytes32 keccak = keccak256(data);
		(bytes64 otherShake, bytes32 otherKeccak) = b.hashes(this, data);
		assert(shake == otherShake);
		assert(keccak == otherKeccak);
	}
	function hash(bytes memory data) public pure returns (bytes64) {
		return shake256(data);
	}
}
==== Source: b.hyp ====
import "a.hyp";
contract B {
	function hashes(A a, bytes memory data) public pure returns (bytes64, bytes32) {
		return (a.hash(data), keccak256(data));
	}
}
