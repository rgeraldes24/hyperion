contract C {
	function xmssverify_value() public pure {
		xmssverify;
		(xmssverify);
		(xmssverify, xmssverify);
	}

	function shake256_value() public pure {
		shake256;
		(shake256);
		(shake256, shake256);
	}

	function mldsa87verify_value() public pure {
		mldsa87verify;
		(mldsa87verify);
		(mldsa87verify, mldsa87verify);
	}
}
