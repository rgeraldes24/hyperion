contract C {
	function f(bytes64 digest, bytes memory signature, bytes memory publicKey, bytes memory context) public pure {
		bool first = mldsa87verify(digest, signature, publicKey, context);
		bool second = mldsa87verify(digest, signature, publicKey, context);
		assert(first == second);
	}
}
