contract C {
    uint256 order;

    function markedKey(uint256 length) internal pure returns (bytes memory publicKey) {
        publicKey = new bytes(length);
        publicKey[0] = 0x44;
    }

    function markedSignature(uint256 length) internal pure returns (bytes memory signature) {
        signature = new bytes(length);
        signature[0] = 0x43;
    }

    function signedContext(uint256 length) internal pure returns (bytes memory context) {
        bytes memory pattern = "QNS-SIGN-v1";
        context = new bytes(length);
        for (uint256 i = 0; i < length; ++i)
            context[i] = pattern[i % pattern.length];
    }

    function verify(bytes1 marker) internal pure returns (bool) {
        return mldsa87verify(bytes64(marker), markedSignature(4627), markedKey(2592), bytes("QNS-SIGN-v1"));
    }

    function valid() public pure returns (bool) {
        return verify(0x42);
    }

    function invalid() public pure returns (bool) {
        return mldsa87verify(bytes64(0), new bytes(0), new bytes(0), new bytes(0));
    }

    function invalidSignature() public pure returns (bool) {
        return verify(0x47);
    }

    function noncanonical() public pure returns (bool) {
        return verify(0x45);
    }

    function canonicalFalse() public pure returns (bool) {
        return verify(0x46);
    }

    function shortTrue() public pure returns (bool) {
        return verify(0x48);
    }

    function literalContext() public pure returns (bool) {
        return mldsa87verify(bytes64(bytes1(0x42)), markedSignature(4627), markedKey(2592), "QNS-SIGN-v1");
    }

    function verifyCalldata(
        bytes64 digest,
        bytes calldata signature,
        bytes calldata publicKey,
        bytes calldata context
    ) external pure returns (bool) {
        return mldsa87verify(digest, signature, publicKey, context);
    }

    function calldataArguments() public view returns (bool) {
        return this.verifyCalldata(bytes64(bytes1(0x42)), markedSignature(4627), markedKey(2592), "QNS-SIGN-v1");
    }

    function emptyContext() public pure returns (bool) {
        return mldsa87verify(bytes64(bytes1(0x42)), markedSignature(4627), markedKey(2592), "");
    }

    function maxContext() public pure returns (bool) {
        return mldsa87verify(bytes64(bytes1(0x42)), markedSignature(4627), markedKey(2592), signedContext(255));
    }

    function oversizedContext() public pure returns (bool) {
        return mldsa87verify(bytes64(bytes1(0x42)), markedSignature(4627), markedKey(2592), signedContext(256));
    }

    // Without the length check, the precompile would read a 4627-byte signature
    // ending in the context length byte, then an 11-byte context.
    function misalignedSignature() public pure returns (bool) {
        return mldsa87verify(bytes64(bytes1(0x42)), markedSignature(4626), markedKey(2592), bytes.concat(bytes1(0x0b), "QNS-SIGN-v1"));
    }

    // Without the length check, the precompile would read a 2592-byte public key
    // ending in the first signature byte, then a 4627-byte signature.
    function misalignedPublicKey() public pure returns (bool) {
        bytes memory signature = new bytes(4628);
        signature[1] = 0x43;
        return mldsa87verify(bytes64(bytes1(0x42)), signature, markedKey(2591), "QNS-SIGN-v1");
    }

    function record(uint256 step) internal returns (uint256) {
        order = order * 10 + step;
        return step;
    }

    function argumentOrder() public returns (bool result, uint256) {
        result = mldsa87verify(
            bytes64(bytes32(record(1))),
            new bytes(record(2)),
            new bytes(record(3)),
            new bytes(record(4))
        );
        return (result, order);
    }

    // A precompile call that runs out of gas reverts instead of returning false.
    function callValid(uint256 gasLimit) public view returns (bool success, bool result) {
        bytes memory data;
        (success, data) = address(this).staticcall{gas: gasLimit}(abi.encodeCall(this.valid, ()));
        if (success)
            result = abi.decode(data, (bool));
    }
}
